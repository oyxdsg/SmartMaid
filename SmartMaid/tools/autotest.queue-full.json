[
  { "__comment": "队列全量回归 v3：开局彻底隔离环境（和平+禁刷怪+清队列，清掉上一轮持久化恢复的队列）。" },

  { "__comment": "环境隔离 + 重置队列" },
  { "id": "e1", "run": "difficulty peaceful" },
  { "id": "e2", "run": "gamerule doMobSpawning false" },
  { "id": "e3", "run": "time set day" },
  { "id": "e4", "run": "kill @e[type=minecraft:zombie]" },
  { "id": "e5", "run": "kill @e[type=minecraft:skeleton]" },
  { "id": "e6", "run": "kill @e[type=minecraft:creeper]" },
  { "id": "e7", "run": "kill @e[type=minecraft:spider]" },
  { "id": "e8", "run": "kill @e[type=minecraft:drowned]" },
  { "id": "e9", "run": "kill @e[type=minecraft:husk]" },
  { "id": "e10", "run": "kill @e[type=minecraft:stray]" },
  { "id": "e11", "run": "kill @e[type=minecraft:witch]" },
  { "id": "e12", "run": "kill @e[type=minecraft:slime]" },
  { "id": "e13", "run": "kill @e[type=minecraft:phantom]" },
  { "id": "e14", "cmd": "queue", "params": { "op": "clear", "kind": "SHORT" }, "expect": { "ok": true } },
  { "id": "e15", "cmd": "queue", "params": { "op": "clear", "kind": "LONG" }, "expect": { "ok": true } },
  { "id": "e16", "cmd": "queue", "params": { "op": "cancelCurrent" }, "expect": { "ok": true } },
  { "id": "e17", "cmd": "status" },
  { "id": "e18", "cmd": "status" },
  { "id": "e19", "cmd": "status" },
  { "id": "e20", "cmd": "status" },

  { "id": "b0", "cmd": "status", "expect": { "ok": true, "result.short_size": 0, "result.long_size": 0 } },

  { "__comment": "holder：长期 guard 占住 current（后续任务排队不执行，断言稳定）" },
  { "id": "ch", "cmd": "guard", "params": { "range": 12 }, "queue": true, "long_term": true,
    "expect": { "ok": true, "state": "queued" } },
  { "id": "cw1", "cmd": "status" },
  { "id": "cw2", "cmd": "status" },
  { "id": "cw3", "cmd": "status" },

  { "__comment": "Q6a 同键去重" },
  { "id": "m1", "cmd": "move", "params": { "pos": ["{x+8}", "{y}", "{z}"] }, "queue": true,
    "expect": { "ok": true, "state": "queued" } },
  { "id": "m2", "cmd": "move", "params": { "pos": ["{x+8}", "{y}", "{z}"] }, "queue": true, "expect": { "ok": false } },
  { "id": "m3", "cmd": "move", "params": { "pos": ["{x+9}", "{y}", "{z}"] }, "queue": true,
    "expect": { "ok": true, "state": "queued" } },

  { "__comment": "Q4 队列操作" },
  { "id": "ea1", "cmd": "eat", "params": { "item": "minecraft:apple" }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "ea2", "cmd": "eat", "params": { "item": "minecraft:bread" }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "ea3", "cmd": "eat", "params": { "item": "minecraft:carrot" }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "qp", "cmd": "queue", "params": { "op": "query" },
    "expect": { "ok": true, "result.current.cmd": "guard", "result.combat": false } },
  { "id": "qmu", "cmd": "queue", "params": { "op": "moveUp", "id": "ea3" }, "expect": { "ok": true } },
  { "id": "qrm", "cmd": "queue", "params": { "op": "remove", "id": "ea2", "kind": "SHORT" }, "expect": { "ok": true } },
  { "id": "slt", "cmd": "queue", "params": { "op": "setLongTerm", "id": "ea3", "long_term": true }, "expect": { "ok": true } },
  { "id": "qp2", "cmd": "queue", "params": { "op": "query" },
    "expect": { "ok": true, "result.short_size": 3, "result.long_size": 1 } },

  { "__comment": "Q4 整组停止" },
  { "id": "sgc", "cmd": "queue", "params": { "op": "clear", "kind": "SHORT" }, "expect": { "ok": true } },
  { "id": "sg1", "cmd": "smelt", "params": { "item": "minecraft:iron_ingot", "count": 1 }, "queue": true, "group": "g1", "group_label": "烧所有矿物", "expect": { "ok": true } },
  { "id": "sg2", "cmd": "smelt", "params": { "item": "minecraft:diamond", "count": 1 }, "queue": true, "group": "g1", "group_label": "烧所有矿物", "expect": { "ok": true } },
  { "id": "sgs", "cmd": "queue", "params": { "op": "stopGroup", "group": "g1" }, "expect": { "ok": true, "result.removed": 2 } },
  { "id": "qps", "cmd": "queue", "params": { "op": "query" }, "expect": { "ok": true, "result.short_size": 0 } },

  { "__comment": "Q6b guard 合并" },
  { "id": "gm", "cmd": "guard", "params": { "range": 5 }, "queue": true, "long_term": true, "expect": { "ok": true, "result.merged": true } },

  { "__comment": "Q9 script 入队" },
  { "id": "sc", "cmd": "script", "params": { "name": "测试脚本", "steps": [ { "cmd": "status" } ] }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "sccl", "cmd": "queue", "params": { "op": "clear", "kind": "SHORT" }, "expect": { "ok": true } },

  { "__comment": "Q5 战斗打断：normal + 召僵尸 → 任务暂停(COMBAT)/任务恢复" },
  { "id": "diff", "run": "difficulty normal" },
  { "id": "cz", "run": "summon minecraft:zombie {x+4} {y} {z}" },
  { "id": "w1", "cmd": "status" }, { "id": "w2", "cmd": "status" }, { "id": "w3", "cmd": "status" },
  { "id": "w4", "cmd": "status" }, { "id": "w5", "cmd": "status" }, { "id": "w6", "cmd": "status" },
  { "id": "w7", "cmd": "status" }, { "id": "w8", "cmd": "status" }, { "id": "w9", "cmd": "status" },
  { "id": "w10", "cmd": "status" }, { "id": "w11", "cmd": "status" }, { "id": "w12", "cmd": "status" },
  { "id": "czk", "run": "kill @e[type=minecraft:zombie]" },
  { "id": "pz1", "run": "difficulty peaceful" },
  { "id": "pz2", "cmd": "status" }, { "id": "pz3", "cmd": "status" }, { "id": "pz4", "cmd": "status" },
  { "id": "stop", "cmd": "queue", "params": { "op": "cancelCurrent" }, "expect": { "ok": true } },
  { "id": "post0", "cmd": "status" }, { "id": "post1", "cmd": "status" }, { "id": "post2", "cmd": "status" },

  { "__comment": "Q6c 熔炉租约" },
  { "id": "fz", "run": "setblock {x+3} {y-1} {z} minecraft:furnace" },
  { "id": "fg", "give": { "minecraft:raw_iron": 4, "minecraft:raw_gold": 4, "minecraft:coal": 8 } },
  { "id": "s1", "cmd": "smelt", "params": { "item": "minecraft:iron_ingot", "count": 1 }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "s2", "cmd": "smelt", "params": { "item": "minecraft:gold_ingot", "count": 1 }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "sw1", "cmd": "status" }, { "id": "sw2", "cmd": "status" }, { "id": "sw3", "cmd": "status" },
  { "id": "sw4", "cmd": "status" }, { "id": "sw5", "cmd": "status" }, { "id": "sw6", "cmd": "status" },
  { "id": "sw7", "cmd": "status" }, { "id": "sw8", "cmd": "status" }, { "id": "sw9", "cmd": "status" },
  { "id": "sw10", "cmd": "status" }, { "id": "sw11", "cmd": "status" }, { "id": "sw12", "cmd": "status" },
  { "id": "scl", "cmd": "queue", "params": { "op": "clear", "kind": "SHORT" }, "expect": { "ok": true } },
  { "id": "scc", "cmd": "queue", "params": { "op": "cancelCurrent" }, "expect": { "ok": true } },

  { "__comment": "ChestStoreTask（再隔离一次环境）" },
  { "id": "e21", "run": "difficulty peaceful" },
  { "id": "e22", "run": "kill @e[type=minecraft:zombie]" },
  { "id": "e23", "run": "kill @e[type=minecraft:creeper]" },
  { "id": "e24", "run": "kill @e[type=minecraft:skeleton]" },
  { "id": "chz", "run": "setblock {x+3} {y-1} {z+2} minecraft:chest" },
  { "id": "chg", "give": { "minecraft:dirt": 3 } },
  { "id": "cheq", "cmd": "equip", "params": { "item": "minecraft:dirt" } },
  { "id": "chstore", "cmd": "cheststore", "params": { "pos": ["{x+3}", "{y-1}", "{z+2}"], "count": 64 }, "queue": true, "expect": { "ok": true, "state": "queued" } },
  { "id": "chw1", "cmd": "status" }, { "id": "chw2", "cmd": "status" }, { "id": "chw3", "cmd": "status" },
  { "id": "chw4", "cmd": "status" }, { "id": "chw5", "cmd": "status" }, { "id": "chw6", "cmd": "status" },
  { "id": "chw7", "cmd": "status" }, { "id": "chw8", "cmd": "status" }, { "id": "chw9", "cmd": "status" },
  { "id": "chw10", "cmd": "status" },
  { "id": "chclear", "cmd": "queue", "params": { "op": "clear", "kind": "SHORT" } },
  { "id": "chcc", "cmd": "queue", "params": { "op": "cancelCurrent" } },

  { "id": "z1", "run": "kill @e[type=minecraft:zombie]" }
]
